# infra/.env 로 복사해서 쓴다(make up 이 없으면 자동으로 복사). 값은 랩 전용 가짜 값이다.
# 포트가 PC의 다른 프로그램과 겹치면 여기서 바꾼다(예: PC에 MySQL이 이미 있으면 DAON_MYSQL_PORT=13306).

# PC 쪽에서 포트를 여는 주소. A0는 "모든 포트가 PC에 열려 있는" 구조를 보여 주지만,
# 같은 와이파이의 다른 기기에서는 닿지 않도록 기본은 127.0.0.1이다. 0.0.0.0으로 바꾸지 않는다.
DAON_BIND=127.0.0.1

# Spring 스택
DAON_MYSQL_PORT=3306
DAON_REDIS_PORT=6379
DAON_RABBIT_PORT=5672
DAON_RABBIT_UI_PORT=15672
DAON_MONGO_PORT=27017
DAON_MINIO_PORT=9000
DAON_MINIO_UI_PORT=9001
DAON_GATEWAY_ADMIN_PORT=8443
DAON_ADMIN_API_PORT=8080
DAON_PORTAL_API_PORT=8085
DAON_ADMIN_WEB_PORT=8090
DAON_OPS_PORT=8095

# Express 스택
DAON_PG_PORT=5432
DAON_EVERSHOP_PORT=3000

# 랩 도구(infra/compose.lab.yml): 고객 웹(spring), 가짜 외부 서비스(두 스택 모두, stubs/README.md)
DAON_WEB_PORT=8088
DAON_PAYMENT_PORT=9101
DAON_SMS_PORT=9102
DAON_COURIER_PORT=9103
DAON_MAILPIT_PORT=8025
DAON_SMTP_PORT=1025

# A3(4-3) Redis 앱별 사용자 비밀번호. 랩 전용 가짜 값이다(6-3에서 시크릿 저장소로 옮긴다)
DAON_REDIS_PORTAL_PASSWORD=lab-fake-portal-redis
DAON_REDIS_ADMIN_PASSWORD=lab-fake-admin-redis
DAON_REDIS_OPS_PASSWORD=lab-fake-ops-redis
# 6-2: 설정 파일(application-*.yml)에서 뺀 값을 채운다. 랩 전용 가짜 값(원본 데모 기본값 그대로)이며 6-3에서 시크릿 저장소로 옮긴다
DAON_DB_USER=reader
DAON_DB_PASSWORD=123456
DAON_DRUID_PASSWORD=druid
# 6-3: 시크릿 저장소 준비에 쓰는 랩 전용 가짜 값(MySQL 계정 openbao의 비밀번호, 모니터링 화면 비밀번호의 처음 값). 앱 설정 파일에는 없다
DAON_BAO_DB_PASSWORD=lab-fake-bao-db
DAON_DRUID_PASSWORD_VAULT=lab-fake-druid-console
# 6-4: Redis 권한 캐시 서명 키의 처음 값(랩 전용 가짜 값). 앱은 시크릿 저장소에서만 읽는다
DAON_CACHE_HMAC_KEY=lab-fake-cache-hmac-key-0001
# 6-4: 저장소 서버 쪽 계정(랩 전용 가짜 값). 앱은 이 값을 환경 변수로 받지 않고 시크릿 저장소(OpenBao KV)에서 받는다.
#      서버를 준비하는 쪽(mongo·rabbitmq·minio 컨테이너, openbao-init)만 이 파일을 읽는다. 알려진 기본값(minioadmin·mall 등)은 쓰지 않는다
DAON_MONGO_APP_PASSWORD=lab-fake-mongo-app-0001
DAON_MONGO_OPS_PASSWORD=lab-fake-mongo-ops-0001
DAON_RABBIT_APP_PASSWORD=lab-fake-rabbit-app-0001
DAON_RABBIT_OPS_PASSWORD=lab-fake-rabbit-ops-0001
DAON_MINIO_ROOT_USER=daon-minio-root
DAON_MINIO_ROOT_PASSWORD=lab-fake-minio-root-0001
DAON_MINIO_APP_ACCESS_KEY=daon-app-key
DAON_MINIO_APP_SECRET_KEY=lab-fake-minio-app-0001

# 7-5: 로컬 CI(A8)의 Gitea 계정 비밀번호. 랩 전용 가짜 값이다
DAON_CI_PORT=3300
DAON_CI_ADMIN_PASSWORD=lab-fake-ci-admin-0001
DAON_CI_PUSH_PASSWORD=lab-fake-ci-push-0001
DAON_CI_REGISTRY_PORT=5050
DAON_CI_SIGN_PASSWORD=lab-fake-sign-0001
# 7-미션: 방어 스위치 파일 서명 키(랩 전용 가짜 값). make switch가 서명하고 앱이 확인한다
DAON_SWITCH_SIGN_KEY=lab-fake-switch-sign-0001
