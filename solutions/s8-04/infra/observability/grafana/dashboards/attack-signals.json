        }
      ]
    },
    {
      "id": 4,
      "title": "인증 실패 HTTP 401(1분, auth.denied.token)",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({event=\"auth.denied.token\"} [1m]))",
          "queryType": "range",
          "legendFormat": "401",
          "editorMode": "code"
        }
      ],
      "description": "8-4(F32) 전에는 실패가 HTTP 200으로 나가 이 칸이 늘 0이었다"
    },
    {
      "id": 5,
      "title": "감사 로그: 계정별 조회 건수(10분 합계)",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
