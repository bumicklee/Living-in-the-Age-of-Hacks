{
  "uid": "daon-attack-signals",
  "title": "공격 징후(다온마켓)",
  "tags": [
    "daon",
    "8-4"
  ],
  "timezone": "Asia/Seoul",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "description": "교육용 랩 · 127.0.0.1 · 값은 가짜. 섹션 2~7의 SECURITY 줄, 8-3의 AUDIT 줄, 섹션 7의 도구 이벤트를 한 화면에",
  "panels": [
    {
      "id": 1,
      "title": "수업별 공격 징후(고른 기간)",
      "type": "bargauge",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (lesson) (count_over_time({stream=~\"security|tool\"} [$__interval]))",
          "queryType": "range",
          "legendFormat": "{{lesson}}",
          "editorMode": "code"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "values": false,
          "fields": ""
        }
      },
      "description": "섹션 2~7에서 수업마다 한 줄씩 심은 SECURITY 이벤트. 새 수업이 이벤트를 만들면 여기 저절로 나타난다"
    },
    {
      "id": 2,
      "title": "이벤트별 줄 수(고른 기간)",
