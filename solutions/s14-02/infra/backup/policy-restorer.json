{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DaonBackupRestorerListAndRead",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:ListBucketVersions", "s3:GetBucketLocation", "s3:GetBucketObjectLockConfiguration"],
      "Resource": ["arn:aws:s3:::daon-backup"]
    },
    {
      "Sid": "DaonBackupRestorerReadOnly",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion", "s3:GetObjectRetention"],
      "Resource": ["arn:aws:s3:::daon-backup/*"]
    }
  ]
}
