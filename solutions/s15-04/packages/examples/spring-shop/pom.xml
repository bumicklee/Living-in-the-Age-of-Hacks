<?xml version="1.0" encoding="UTF-8"?>
<!-- 다온 가게: 회사 서비스 흉내(15-4 수업). 이 앱에 secure-kit 부품 셋을 붙인다 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.14</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>spring-shop</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>spring-shop</name>
    <description>다온 가게(15-4 수업용 회사 서비스)</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 15-4: 의존성 한 줄(먼저 mvn -f packages/secure-kit-spring/pom.xml install) -->
        <dependency>
            <groupId>io.github.securekit</groupId>
            <artifactId>secure-kit-spring-boot-starter</artifactId>
            <version>0.1.0-SNAPSHOT</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>spring-shop</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
