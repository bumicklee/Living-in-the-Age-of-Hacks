+// 다온마켓 9-3(E10): 질의 깊이 상한. 중첩이 깊은 질의 하나가 DB 질의를 곱으로 늘린다
+const MAX_DEPTH = 10;
+function depthLimitRule(context) {
+  const fragments = Object.create(null);
+  for (const d of context.getDocument().definitions) {
+    if (d.kind === Kind.FRAGMENT_DEFINITION) fragments[d.name.value] = d;
+  }
+  const depthOf = (node, depth, seen) => {
+    if (!node.selectionSet) return depth;
+    let max = depth;
+    for (const sel of node.selectionSet.selections) {
+      if (sel.kind === Kind.FRAGMENT_SPREAD) {
+        const f = fragments[sel.name.value];
+        if (f && !seen.has(f.name.value)) max = Math.max(max, depthOf(f, depth, new Set([...seen, f.name.value])));
+      } else {
+        max = Math.max(max, depthOf(sel, depth + 1, seen));
+      }
+    }
+    return max;
+  };
+  return {
+    OperationDefinition(node) {
+      if (depthOf(node, 0, new Set()) > MAX_DEPTH) {
+        context.reportError(new GraphQLError(`질의 깊이가 상한(${MAX_DEPTH})을 넘습니다`, { nodes: [node], extensions: { code: 'DEPTH_LIMIT' } }));
+      }
+    }
+  };
+}
