 import bodyParser from 'body-parser';
+import { securityEvent } from '../log/securityEvent.js';
 import { EvershopRequest } from '../../types/request.js';
 import { EvershopResponse } from '../../types/response.js';
 
+// 다온마켓 9-3: 상한을 기본값에 맡기지 않고 적는다. body-parser의 limit은 압축을 푼 뒤(inflate) 읽은 바이트로 센다.
+// 넘으면 413(오류 처리기가 4xx를 그대로 내보낸다, 9-2) + input.denied.too_large. 바이트 수 대신 구간만 남긴다.
+const LIMIT = process.env.DAON_MAX_BODY || '100kb';
+const parser = bodyParser.json({ limit: LIMIT, inflate: true });
+
 export default (request: EvershopRequest, response: EvershopResponse, next) => {
-  bodyParser.json()(request, response, next);
+  parser(request, response, (err) => {
+    if (err && err.type === 'entity.too.large') {
+      securityEvent.denied('input.denied.too_large', '9-3', request as any, {
+        target: `path:${String(request.path).replace(/[^A-Za-z0-9/._-]/g, '').slice(0, 120)}`,
+        reason: `본문 크기 상한(${LIMIT}) 초과(압축 해제 뒤 기준)`
+      });
+    }
+    next(err);
+  });
 };
