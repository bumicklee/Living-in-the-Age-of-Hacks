 export default async (err, request, response, next) => {
+  // 다온마켓 6-5(E17): 운영 모드에서는 일반 문구 + trace_id. 원인은 같은 번호로 서버 로그에만
+  const traceId = String(request.headers['x-trace-id'] || randomUUID());
+  const expose = isDevelopmentMode();
