@@ -0,0 +1,37 @@
+/**
+ * 다온마켓 10-6(T27) Express: 결제 시도를 흐름 단위로 센다. Spring DaonCheckoutLimiter와 같은 랩 값.
+ * 메모리 카운터라 앱이 여러 대면 맞지 않는다(그때는 4-3처럼 Redis). 넘으면 checkout.denied.rate_limit.
+ */
+import type { Request } from 'express';
+import { securityEvent } from '../log/securityEvent.js';
+
+const WINDOW_MS = 10 * 60 * 1000;
+const LIMITS = { account: 5, ip: 20 };
+const hits = new Map<string, number[]>();
+
+function bump(key: string): number {
+  const now = Date.now();
+  const list = (hits.get(key) || []).filter((t) => now - t <= WINDOW_MS);
+  list.push(now);
+  hits.set(key, list);
+  return list.length;
+}
+
+/** 통과면 true. 한도를 넘었으면 이벤트를 남기고 false */
+export function checkoutLimit(request: Request, actor: string): boolean {
+  const axes: [string, string, number][] = [
+    ['계정', `acct:${actor}`, LIMITS.account],
+    ['IP', `ip:${request.ip}`, LIMITS.ip]
+  ];
+  for (const [name, key, limit] of axes) {
+    if (bump(key) > limit) {
+      securityEvent.denied('checkout.denied.rate_limit', '10-6', request, {
+        actor,
+        target: 'route:createPaymentIntent',
+        reason: `${name} 축 결제 시도 한도`
+      });
+      return false;
+    }
+  }
+  return true;
+}
