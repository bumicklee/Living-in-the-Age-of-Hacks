+import { execute, type PoolClient } from '@evershop/postgres-query-builder';
+
+/**
+ * 다온마켓 12-2(T33, 교육용 추가): 파트너 연동 표와 랩 시드(Spring DaonPartnerSchema와 같은 이름·같은 가짜 값).
+ * daon_partner_app(대장) · daon_partner_credential(비밀값 SHA-256, 회전) · daon_partner_order(배정) · daon_partner_token(발급 jti)
+ */
+export default async (connection: PoolClient) => {
+  await execute(connection, `CREATE TABLE IF NOT EXISTS daon_partner_app (
+    id varchar(40) PRIMARY KEY, name varchar(100) NOT NULL, owner varchar(100), scopes varchar(200) NOT NULL,
+    status varchar(16) NOT NULL DEFAULT 'active', expires_at timestamptz, last_used_at timestamptz,
+    secret_rotated_at timestamptz, created_at timestamptz NOT NULL DEFAULT NOW())`);
+  await execute(connection, `CREATE TABLE IF NOT EXISTS daon_partner_credential (
+    id serial PRIMARY KEY, app_id varchar(40) NOT NULL, secret_sha256 char(64) NOT NULL,
+    created_ms bigint NOT NULL, retire_at_ms bigint)`);
+  await execute(connection, `CREATE TABLE IF NOT EXISTS daon_partner_order (
+    order_id int PRIMARY KEY, app_id varchar(40) NOT NULL)`);
+  await execute(connection, `CREATE TABLE IF NOT EXISTS daon_partner_token (
+    jti varchar(40) PRIMARY KEY, app_id varchar(40) NOT NULL, scopes varchar(200) NOT NULL, cnf varchar(64),
+    issued_ms bigint NOT NULL, expires_ms bigint NOT NULL)`);
+  await execute(connection, `INSERT INTO daon_partner_app (id, name, owner, scopes, last_used_at, secret_rotated_at) VALUES
+    ('courier-01', '다온 배송 파트너(가짜)', '물류팀 김가짜(logistics@daon.example)', 'orders:read:assigned', NOW() - INTERVAL '1 day', NOW() - INTERVAL '20 days'),
+    ('analytics-01', '다온 판매 분석 파트너(가짜)', '마케팅팀 이가짜(marketing@daon.example)', 'orders:read:assigned orders:export', NOW() - INTERVAL '2 days', NOW() - INTERVAL '30 days'),
+    ('legacy-01', '옛 정산 대행(가짜, 계약 끝)', '재무팀 박가짜(finance@daon.example)', 'orders:read:assigned', NOW() - INTERVAL '120 days', NOW() - INTERVAL '200 days')
+    ON CONFLICT (id) DO NOTHING`);
+  await execute(connection, `INSERT INTO daon_partner_credential (app_id, secret_sha256, created_ms)
+    SELECT a, encode(sha256(('lab-fake-partner-secret-' || a || '-v1')::bytea), 'hex'), (EXTRACT(EPOCH FROM NOW()) * 1000)::bigint
+    FROM unnest(ARRAY['courier-01', 'analytics-01', 'legacy-01']) AS a
+    WHERE NOT EXISTS (SELECT 1 FROM daon_partner_credential c WHERE c.app_id = a)`);
+  await execute(connection, `INSERT INTO daon_partner_order (order_id, app_id)
+    SELECT order_id, 'courier-01' FROM "order" WHERE order_id BETWEEN 9004 AND 9300
+      AND meta_data ->> 'delivery_sn' IS NOT NULL AND order_id % 3 = 0
+    ON CONFLICT (order_id) DO NOTHING`);
+  await execute(connection, `INSERT INTO daon_partner_order (order_id, app_id)
+    SELECT order_id, 'analytics-01' FROM "order" WHERE order_id BETWEEN 9004 AND 9300 AND order_id % 10 = 1
+    ON CONFLICT (order_id) DO NOTHING`);
+};
