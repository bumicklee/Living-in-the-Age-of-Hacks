diff --git a/packages/evershop/src/modules/oms/api/daonPartnerToken/daonPartnerToken.ts b/packages/evershop/src/modules/oms/api/daonPartnerToken/daonPartnerToken.ts
new file mode 100644
index 0000000..5d7ab15
--- /dev/null
+++ b/packages/evershop/src/modules/oms/api/daonPartnerToken/daonPartnerToken.ts
@@ -0,0 +1,42 @@
+import { createHash, timingSafeEqual } from 'crypto';
+import { pool } from '../../../../lib/postgres/connection.js';
+import { securityEvent } from '../../../../lib/log/securityEvent.js';
+import { fromPartnerGateway, signPartnerToken, TOKEN_SECONDS } from '../../../../lib/secureKit/partnerScope.js';
+
+/**
+ * 다온마켓 12-2(T33) · POST /api/partner/token  grant_type=client_credentials&client_id=…&client_secret=…[&scope=…]
+ * 15분 토큰(aud daon-partner). 요청 범위는 대장(daon_partner_app.scopes) 안에서만, orders:export는 기본 발급에서 뺀다.
+ * 비밀값은 SHA-256만 비교(상수 시간), 겹침 기간(retire_at_ms)이 지난 옛 값은 거부. Spring DaonPartnerTokenController와 같다.
+ */
+const sha256 = (s: string) => createHash('sha256').update(s, 'utf8').digest('hex');
+
+export default async (request, response) => {
+  response.set('Cache-Control', 'no-store');
+  if (!(await fromPartnerGateway(request))) return response.status(404).json({ error: 'not_found' });
+  const { grant_type: grantType, client_id: clientId, client_secret: secret, scope } = request.body || {};
+  if (grantType !== 'client_credentials') return response.status(400).json({ error: 'unsupported_grant_type' });
+  const valid = typeof clientId === 'string' && /^[a-z0-9-]{3,40}$/.test(clientId);
+  const app = valid ? (await pool.query('SELECT id, scopes, status FROM daon_partner_app WHERE id = $1', [clientId])).rows[0] : null;
+  const now = Date.now();
+  let ok = false;
+  if (app && typeof secret === 'string' && secret) {
+    const given = Buffer.from(sha256(secret));
+    const rows = (await pool.query('SELECT secret_sha256, retire_at_ms FROM daon_partner_credential WHERE app_id = $1', [clientId])).rows;
+    for (const r of rows) {
+      const usable = r.retire_at_ms === null || Number(r.retire_at_ms) > now;
+      ok = (usable && timingSafeEqual(given, Buffer.from(r.secret_sha256))) || ok;
+    }
+  }
+  if (!ok) {
+    const who = app ? `partner:${clientId}` : 'partner:unknown';
+    securityEvent.denied('partner.denied.bad_credential', '12-2', request, { actor: who, target: who, reason: '파트너 비밀값이 틀림(또는 없는 파트너)' });
+    return response.status(401).json({ error: 'invalid_client' });
+  }
+  const allowed = String(app.scopes).split(' ').filter(Boolean);
+  const wanted = String(scope || 'orders:read:assigned').split(' ').filter(Boolean);
+  if (!wanted.length || !wanted.every((s) => allowed.includes(s))) return response.status(400).json({ error: 'invalid_scope' });
+  const { token, jti } = signPartnerToken(clientId, wanted);
+  await pool.query('INSERT INTO daon_partner_token (jti, app_id, scopes, cnf, issued_ms, expires_ms) VALUES ($1, $2, $3, $4, $5, $6)',
+    [jti, clientId, wanted.join(' '), null, now, now + TOKEN_SECONDS * 1000]);
+  return response.status(200).json({ access_token: token, token_type: 'Bearer', expires_in: TOKEN_SECONDS, scope: wanted.join(' ') });
+};
