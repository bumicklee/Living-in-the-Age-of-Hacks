+import { pool } from '../../../../lib/postgres/connection.js';
+import { kit } from '../../../../lib/secureKit/partnerScope.js';
+
+/**
+ * 다온마켓 12-2(T33) · GET /api/partner/orders?page=&size=  배정된 주문만(쪽 나눔, 한 쪽 최대 100).
+ * 범위(kit.partnerScope)와 조회 조건(daon_partner_order.app_id = 토큰의 partner_id)을 둘 다 쓴다.
+ */
+export default async (request, response) => {
+  const partner = await kit.partnerScope('orders:read:assigned')(request, response);
+  if (!partner) return;
+  const page = Math.max(1, parseInt(String(request.query.page || '1'), 10) || 1);
+  const size = Math.min(100, Math.max(1, parseInt(String(request.query.size || '50'), 10) || 50));
+  const total = (await pool.query(
+    'SELECT COUNT(*)::int AS n FROM "order" o JOIN daon_partner_order po ON po.order_id = o.order_id WHERE po.app_id = $1',
+    [partner.appId])).rows[0].n;
+  const items = (await pool.query(
+    `SELECT o.order_id AS id, o.order_number AS "orderSn", o.shipment_status AS status, o.meta_data ->> 'delivery_sn' AS "deliverySn"
+       FROM "order" o JOIN daon_partner_order po ON po.order_id = o.order_id
+      WHERE po.app_id = $1 ORDER BY o.order_id LIMIT $2 OFFSET $3`,
+    [partner.appId, size, (page - 1) * size])).rows;
+  response.set('Cache-Control', 'no-store');
+  return response.status(200).json({ page, size, total, items });
+};
