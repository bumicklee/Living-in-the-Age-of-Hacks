# 12-2 Express(EverShop): 같은 교육용 파트너 API를 처음부터 범위·조회 조건·15분 토큰으로 만든다(새 파일만)
# - EverShop에는 파트너 API가 없다. API 경로는 /api 아래에 붙는다: POST /api/partner/token · GET /api/partner/orders · GET /api/partner/orders/export
# - kit.partnerScope('orders:read:assigned'): 입구(소켓 주소 = 게이트웨이) → 토큰(HS256 하나, aud daon-partner) → 만료 → 범위. 조회 조건에 daon_partner_order.app_id
# - 표·랩 시드는 oms 마이그레이션 1.0.12(Spring DaonPartnerSchema와 같은 이름·같은 가짜 값). 서명 키 DAON_PARTNER_TOKEN_KEY(32자 이상, .env)
# - 같은 HTTP 시험(tests/test_s12_02_*)으로 확인한다【실측 예정】(게이트웨이 8087 → evershop:3000/api/partner/ 연결은 Express 실행 랩 때)
# - 적용: diffs/common/express-security-event.diff 다음. cd express && git apply ../diffs/s12-02/express.diff

diff --git a/packages/evershop/src/lib/secureKit/partnerScope.ts b/packages/evershop/src/lib/secureKit/partnerScope.ts
new file mode 100644
index 0000000..6d5e60b
--- /dev/null
+++ b/packages/evershop/src/lib/secureKit/partnerScope.ts
@@ -0,0 +1,106 @@
+/**
+ * 다온마켓 12-2(T33) · secure-kit 부품: 파트너 API 문지기. Spring PartnerScopeInterceptor와 같은 순서·같은 이벤트.
+ *
+ *   const partner = await kit.partnerScope('orders:read:assigned')(request, response);
+ *   if (!partner) return;              // 이미 404·401·403으로 답했다
+ *
+ * ① 입구   소켓 주소가 파트너 입구(게이트웨이, DAON_PARTNER_GATEWAY)인가     아니면 404
+ * ② 토큰   Bearer, HS256 하나만, aud=daon-partner, partner_id             아니면 401
+ * ③ 만료   exp(15분)                                                    지났으면 401 + partner.denied.token_expired(INFO)
+ * ④ 범위   요구 범위가 토큰 scope에 있나                                 없으면 403 + partner.denied.scope(WARN)
+ * 범위는 「무슨 기능」, 조회 조건(daon_partner_order.app_id)은 「누구의 데이터」. 둘 다 쓴다.
+ * 서명 키는 DAON_PARTNER_TOKEN_KEY(32자 이상, 랩 값은 .env). Spring은 OpenBao transit(ES256, kid)을 쓴다【실측 예정: Express 키 체계는 5-2 diff와 맞출지 작성자 결정】.
+ */
+import { randomUUID } from 'crypto';
+import { promises as dns } from 'dns';
+import jwt from 'jsonwebtoken';
+import type { Request, Response } from 'express';
+import { securityEvent } from '../log/securityEvent.js';
+
+export const PARTNER_AUD = 'daon-partner';
+export const TOKEN_SECONDS = 900;
+const ISSUER = 'daon-market';
+const REFRESH_MS = 30_000;
+
+export type PartnerPrincipal = { appId: string; scopes: string[]; jti: string };
+
+let gateways: Set<string> = new Set();
+let loadedAt = 0;
+
+function tokenKey(): string {
+  const k = process.env.DAON_PARTNER_TOKEN_KEY || '';
+  if (k.length < 32) {
+    throw new Error('DAON_PARTNER_TOKEN_KEY가 없거나 짧습니다(32자 이상)');
+  }
+  return k;
+}
+
+function clientAddress(request: Request): string {
+  return (request.socket.remoteAddress || '').replace(/^::ffff:/, '');
+}
+
+/** 파트너 입구(게이트웨이)에서 온 요청인가. 헤더는 믿지 않고 소켓 주소만 본다. 이름을 못 풀면 아무도 믿지 않는다 */
+export async function fromPartnerGateway(request: Request): Promise<boolean> {
+  if (Date.now() - loadedAt > REFRESH_MS) {
+    const next = new Set<string>();
+    for (const name of (process.env.DAON_PARTNER_GATEWAY || 'gateway').split(',')) {
+      try {
+        for (const a of await dns.lookup(name.trim(), { all: true })) next.add(a.address);
+      } catch (e) {
+        // 게이트웨이가 아직 없다(A9 전)
+      }
+    }
+    gateways = next;
+    loadedAt = Date.now();
+  }
+  return gateways.has(clientAddress(request));
+}
+
+export function signPartnerToken(appId: string, scopes: string[], extra: Record<string, unknown> = {}): { token: string; jti: string } {
+  const jti = randomUUID();
+  const token = jwt.sign({ partner_id: appId, scope: scopes.join(' '), ...extra }, tokenKey(), {
+    algorithm: 'HS256', audience: PARTNER_AUD, issuer: ISSUER, subject: `partner:${appId}`, expiresIn: TOKEN_SECONDS, jwtid: jti
+  });
+  return { token, jti };
+}
+
+function reject(response: Response, status: number, error: string, description?: string) {
+  if (status === 401) response.set('WWW-Authenticate', `Bearer error="${error}"`);
+  response.set('Cache-Control', 'no-store');
+  response.status(status).json(description ? { error, error_description: description } : { error });
+  return null;
+}
+
+export const kit = {
+  partnerScope(scope: string) {
+    return async (request: Request, response: Response): Promise<PartnerPrincipal | null> => {
+      if (!(await fromPartnerGateway(request))) return reject(response, 404, 'not_found');
+      const path = `path:${request.originalUrl.split('?')[0]}`;
+      const auth = request.get('authorization') || '';
+      if (!auth.startsWith('Bearer ')) return reject(response, 401, 'invalid_token', '토큰 없음');
+      let claims: any;
+      try {
+        claims = jwt.verify(auth.slice(7).trim(), tokenKey(), { algorithms: ['HS256'], audience: PARTNER_AUD, issuer: ISSUER });
+      } catch (e: any) {
+        if (e && e.name === 'TokenExpiredError') {
+          const decoded: any = jwt.decode(auth.slice(7).trim()) || {};
+          securityEvent.suspicious('partner.denied.token_expired', '12-2', request, {
+            actor: `partner:${decoded.partner_id || 'unknown'}`, target: path, reason: '만료된 파트너 토큰(재발급 전이면 정상, 많으면 재사용 의심)'
+          });
+          return reject(response, 401, 'invalid_token', '토큰 만료');
+        }
+        return reject(response, 401, 'invalid_token', '파트너 토큰이 아님');
+      }
+      if (!claims || !claims.partner_id) return reject(response, 401, 'invalid_token', '파트너 토큰이 아님');
+      const actor = `partner:${claims.partner_id}`;
+      const scopes = String(claims.scope || '').split(' ').filter(Boolean);
+      if (!scopes.includes(scope)) {
+        securityEvent.denied('partner.denied.scope', '12-2', request, {
+          actor, target: path, reason: `범위 밖 기능 호출(필요한 범위 ${scope})`
+        });
+        return reject(response, 403, 'insufficient_scope', '범위 밖 기능');
+      }
+      return { appId: String(claims.partner_id), scopes, jti: String(claims.jti || '') };
+    };
+  }
+};
