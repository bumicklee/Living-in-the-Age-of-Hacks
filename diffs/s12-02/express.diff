@@ -0,0 +1,17 @@
+import { pool } from '../../../../lib/postgres/connection.js';
+import { kit } from '../../../../lib/secureKit/partnerScope.js';
+
+/**
+ * 다온마켓 12-2(T33) · GET /api/partner/orders/export  배정된 주문 한 번에(최대 1000). 범위 orders:export(기본 발급에서 빠짐).
+ */
+export default async (request, response) => {
+  const partner = await kit.partnerScope('orders:export')(request, response);
+  if (!partner) return;
+  const items = (await pool.query(
+    `SELECT o.order_id AS id, o.order_number AS "orderSn", o.shipment_status AS status, o.meta_data ->> 'delivery_sn' AS "deliverySn"
+       FROM "order" o JOIN daon_partner_order po ON po.order_id = o.order_id
+      WHERE po.app_id = $1 ORDER BY o.order_id LIMIT 1000`,
+    [partner.appId])).rows;
+  response.set('Cache-Control', 'no-store');
+  return response.status(200).json({ count: items.length, items });
+};
