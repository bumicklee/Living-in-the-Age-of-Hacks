 import { addProcessor, getValueSync } from '../util/registry.js';
 import CustomColorize from './CustomColorize.js';
 
+// 다온마켓 8-5(F35와 같은 문제의 EverShop 쪽): 로그 메시지·스택에서 JWT 모양·휴대전화 모양·password 값을 가린다(마지막 그물).
+// Spring의 LogMask·MaskingConverter와 같은 패턴. 원천에서 남기지 않는 것이 먼저다(오류 처리기는 6-5부터 메시지만 남긴다).
+const SECRET_RULES = [
+  [/eyJ[A-Za-z0-9_-]{5,}\.[A-Za-z0-9_-]{5,}\.[A-Za-z0-9_-]*/g, 'eyJ***'],
+  [/(?<![0-9A-Za-z])01[016789]-?[0-9]{3,4}-?[0-9]{4}(?![0-9A-Za-z])/g, '010-****-****'],
+  [/("(?:password|newPassword|oldPassword|token|refreshToken)"\s*:\s*")[^"]*(")/gi, '$1***$2']
+];
+export function maskSecrets(text) {
+  if (typeof text !== 'string') {
+    return text;
+  }
+  return SECRET_RULES.reduce((out, [rx, to]) => out.replace(rx, to), text);
+}
+const maskFormat = winston.format((info) => {
+  info.message = maskSecrets(info.message);
+  if (info.stack) {
+    info.stack = maskSecrets(info.stack);
+  }
+  return info;
+});
+
 function createLogger() {
   return getValueSync('logger', null, {
     isDebugging: isDevelopmentMode() || process.argv.includes('--debug')
