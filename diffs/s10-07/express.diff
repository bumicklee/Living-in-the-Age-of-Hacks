@@ -0,0 +1,40 @@
+/**
+ * 다온마켓 10-7(T27) Express: 발송 예산. Spring DaonSmsBudget과 같은 랩 값(대상 60초 1번·하루 5번, IP 10분 30번, 전체 한 시간 20건).
+ * 전체 상한에 닿으면 그 시간이 끝날 때까지 멈추고 budget.tripped.global 한 번. 대상(메일·번호) 원문은 로그에 넣지 않는다(해시 앞 8자).
+ * 메모리 카운터(인스턴스 하나 기준). 여러 대면 Redis로.
+ */
+import { createHash } from 'crypto';
+import type { Request } from 'express';
+import { securityEvent } from '../log/securityEvent.js';
+
+const hits = new Map<string, number[]>();
+let trippedUntil = 0;
+
+function bump(key: string, windowMs: number): number {
+  const now = Date.now();
+  const list = (hits.get(key) || []).filter((t) => now - t <= windowMs);
+  list.push(now);
+  hits.set(key, list);
+  return list.length;
+}
+
+export function budget(request: Request, name: string, target: string): boolean {
+  const h = createHash('sha256').update(target).digest('hex').slice(0, 8);
+  const deny = (reason: string) => {
+    securityEvent.denied('budget.denied.sms', '10-7', request, { target: `${name}:${h}`, reason: `${reason}(Express: ${name})` });
+    return false;
+  };
+  if (Date.now() < trippedUntil) return deny('전체 발송 상한으로 멈춘 시간');
+  if (bump(`t60:${name}:${h}`, 60_000) > 1) return deny('대상당 발송 한도(60초 1번)');
+  if (bump(`tday:${name}:${h}`, 86_400_000) > 5) return deny('대상당 발송 한도(하루 5번)');
+  if (bump(`ip:${name}:${request.ip}`, 600_000) > 30) return deny('IP당 발송 한도(10분 30번)');
+  if (bump(`global:${name}`, 3_600_000) > 20) {
+    const now = new Date();
+    trippedUntil = new Date(now.getFullYear(), now.getMonth(), now.getDate(), now.getHours() + 1).getTime();
+    securityEvent.denied('budget.tripped.global', '10-7', request, {
+      actor: `system:${name}`, target: `budget:${name}`, reason: '전체 시간당 발송 상한(20건) 도달, 이 시간 끝까지 발송 중지'
+    });
+    return false;
+  }
+  return true;
+}
