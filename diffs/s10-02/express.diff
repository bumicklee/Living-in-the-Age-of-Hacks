# 10-2 Express(EverShop)에서 고칠 곳: 쿠폰 사용 횟수의 「확인한 뒤 갱신」(T25와 같은 모양)
# - 검사는 장바구니의 timeUsedValidator(used_time < max_uses_time_per_coupon), 갱신은 주문 INSERT 뒤 트리거 set_coupon_used_time.
#   두 주문이 동시에 검사를 통과하면 한도를 넘겨 쓴다. 트리거 함수를 조건부 UPDATE로 바꾸고 0행이면 예외 → 주문 INSERT가 되돌아간다.
# - 새 마이그레이션 하나(Version-1.1.2). 버전 비교로 한 번만 돈다【실측 예정: 모듈 버전 표와 맞는지】.
# - 적용: cd express && git apply ../diffs/s10-02/express.diff (깨끗한 EverShop에도 붙음)

diff --git a/packages/evershop/src/modules/promotion/migration/Version-1.1.2.ts b/packages/evershop/src/modules/promotion/migration/Version-1.1.2.ts
new file mode 100644
--- /dev/null
+++ b/packages/evershop/src/modules/promotion/migration/Version-1.1.2.ts
@@ -0,0 +1,38 @@
+import { execute } from '@evershop/postgres-query-builder';
+import type { PoolClient } from 'pg';
+
+/**
+ * 다온마켓 10-2(T25) Express: 쿠폰 사용 횟수를 「검사와 갱신을 한 문장」으로.
+ *
+ * 원본(Version-1.0.0)의 set_coupon_used_time()은 used_time = used_time + 1만 했다. 한도 검사는 장바구니
+ * (timeUsedValidator)에서 먼저 하므로, 동시에 들어온 주문 둘이 같은 used_time을 보고 둘 다 통과할 수 있다.
+ * 여기서는 한도 조건을 WHERE에 넣고, 갱신한 행이 없으면 예외를 던져 주문 INSERT 전체를 되돌린다.
+ * 주문을 옮겨 넣는 중(evershop.importing = on)에는 원래대로 센다(Version-1.0.13과 같은 규칙).
+ */
+export default async (connection: PoolClient): Promise<void> => {
+  await execute(
+    connection,
+    `CREATE OR REPLACE FUNCTION set_coupon_used_time()
+        RETURNS TRIGGER
+        LANGUAGE PLPGSQL
+        AS
+      $$
+      BEGIN
+        IF NEW.coupon IS NULL OR NEW.coupon = '' THEN
+          RETURN NEW;
+        END IF;
+        IF current_setting('evershop.importing', true) = 'on' THEN
+          UPDATE "coupon" SET used_time = used_time + 1 WHERE coupon = NEW.coupon;
+          RETURN NEW;
+        END IF;
+        UPDATE "coupon" SET used_time = used_time + 1
+         WHERE coupon = NEW.coupon
+           AND (max_uses_time_per_coupon IS NULL OR used_time < max_uses_time_per_coupon);
+        IF NOT FOUND THEN
+          RAISE EXCEPTION 'coupon.denied.limit_reached' USING ERRCODE = 'check_violation';
+        END IF;
+        RETURN NEW;
+      END;
+      $$;`
+  );
+};
