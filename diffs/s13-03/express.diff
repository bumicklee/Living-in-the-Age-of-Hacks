+/**
+ * 다온마켓 13-3(Express): 승인 서비스(A10)에 「요청」만 하고, 승인 서비스가 서명한 승인 토큰을 확인해야만 실행한다.
+ * Spring의 DaonApprovalClient·DaonApprovalToken·DaonRefundExecutor와 같은 일(course/SECURITY_EVENTS.md 같은 이벤트 이름).
+ *
+ *   const a = await requestApproval(request, { orderId, amount });             // 요청만(관리자 토큰·X-Trace-Id를 그대로 넘긴다)
+ *   const p = a.status === 'APPROVED' ? verifyApprovalToken(a.token, 'refund', orderId) : null;
+ *
+ * - 확인은 승인 서비스 서명 키의 공개키(DAON_APPROVAL_PUBLIC_KEY, PEM)로 앱 안에서 한다. 서명은 승인 서비스만 한다(키는 금고 안).
+ * - 1회용 번호(jti)는 이 프로세스 메모리에 둔다(인스턴스 하나 기준. 여러 대면 DB 유니크 키로 옮긴다).
+ * - 승인 서비스가 안 닿으면 거부로 본다(fail-closed).
+ */
+import { createPublicKey, verify } from 'crypto';
+import type { Request } from 'express';
+
+const BASE = process.env.DAON_APPROVAL_URL || '';
+const PUBLIC_KEY = process.env.DAON_APPROVAL_PUBLIC_KEY || '';
+const used = new Map<string, number>();
+
+export type ApprovalResult = { status: string; id?: string; token?: string; reason?: string };
+
+export async function requestApproval(request: Request, body: Record<string, unknown>): Promise<ApprovalResult> {
+  if (!BASE) {
+    return { status: 'DENIED', reason: '승인 서비스 주소 없음(A10)' };
+  }
+  try {
+    const res = await fetch(`${BASE}/approvals/refund-order`, {
+      method: 'POST',
+      headers: {
+        'Content-Type': 'application/json',
+        Authorization: request.get('authorization') || '',
+        'X-Trace-Id': (request as any).traceId || ''
+      },
+      body: JSON.stringify(body),
+      signal: AbortSignal.timeout(5000)
+    });
+    if (res.status >= 500) {
+      return { status: 'DENIED', reason: `승인 서비스 HTTP ${res.status}` };
+    }
+    return (await res.json()) as ApprovalResult;
+  } catch (e) {
+    return { status: 'DENIED', reason: '승인 서비스에 닿지 않음' };
+  }
+}
+
+/** 서명·종류·대상·만료·1회용 번호를 본다. 맞으면 내용, 아니면 null */
+export function verifyApprovalToken(token: string | undefined, kind: string, target: string): Record<string, any> | null {
+  try {
+    if (!token || !PUBLIC_KEY) return null;
+    const [h, p, s] = token.split('.');
+    if (!h || !p || !s) return null;
+    const header = JSON.parse(Buffer.from(h, 'base64url').toString());
+    if (header.alg !== 'ES256' || header.typ !== 'daon-approval') return null;
+    const ok = verify('sha256', Buffer.from(`${h}.${p}`), { key: createPublicKey(PUBLIC_KEY), dsaEncoding: 'ieee-p1363' },
+      Buffer.from(s, 'base64url'));
+    if (!ok) return null;
+    const body = JSON.parse(Buffer.from(p, 'base64url').toString());
+    if (body.kind !== kind || String(body.order_uuid ?? body.group) !== target) return null;
+    const now = Math.floor(Date.now() / 1000);
+    if (!(Number(body.exp) > now)) return null;
+    for (const [k, exp] of used) if (exp < now) used.delete(k);
+    if (used.has(body.jti)) return null;
+    used.set(body.jti, Number(body.exp));
+    return body;
+  } catch (e) {
+    return null;
+  }
+}
