+    const ignored = Object.keys(body).filter((k) => !ALLOWED.includes(k));
+    if (ignored.length) {
+      // ⑤ 탐지: 허용 밖 항목(그룹·상태 등)이 섞인 요청. 항목 이름만 남기고 값은 남기지 않는다
+      securityEvent.suspicious('input.unexpected_fields', '2-4', request, {
+        actor: `customer:${currentCustomer.uuid}`,
+        target: `customer:${currentCustomer.uuid}`,
+        reason: `허용 밖 항목 무시: ${ignored.slice(0, 20).join(',')}`
+      });
