-    // Take the whole body (so extension fields flow through) but strip the
-    // sensitive fields a customer must not be able to set on themselves.
+    // 다온마켓 2-4: 막을 항목을 고르는 목록(denylist) 대신 받을 항목만 고르는 목록(allowlist).
+    // 새 컬럼이 생겨도 이 목록에 넣기 전에는 고객이 바꿀 수 없다. 확장 필드가 필요하면 여기에 이름을 더한다
+    const ALLOWED = ['full_name', 'email'];
+    const body = { ...(request.body || {}) };
+    const picked: Record<string, unknown> = {};
+    for (const key of ALLOWED) {
