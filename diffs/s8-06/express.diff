+// 프로세스가 다시 뜨면 seq=1부터 새 체인(표준 출력이라 앞 줄을 읽을 수 없다). make audit-verify가 「새 체인 시작」으로 알려 준다.
+const GENESIS = '0'.repeat(64);
+let seq = 0;
+let prev = GENESIS;
+function canonical(o: Record<string, unknown>): string {
+  return JSON.stringify(Object.fromEntries(Object.keys(o).sort().map((k) => [k, o[k]])));
+}
+function link(line: Record<string, unknown>): string {
+  const body = { ...line, seq: ++seq, prev };
+  const hash = createHash('sha256').update(canonical(body), 'utf8').digest('hex');
+  prev = hash;
+  return canonical({ ...body, hash });
+}
