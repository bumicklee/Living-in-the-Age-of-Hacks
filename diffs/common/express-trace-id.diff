index 0000000..9d3edbc
--- /dev/null
+++ b/packages/evershop/src/lib/middlewares/traceId.ts
@@ -0,0 +1,39 @@
+/**
+ * 다온마켓 A3: 요청 추적 번호(trace_id). Spring TraceIdFilter와 같은 규칙. 랩-설계.md 11절
+ *
+ * - 들어올 때: X-Trace-Id(영문·숫자·._- 8~64자) → traceparent의 trace-id → X-Request-Id → 새로 만듦
+ *   모양이 이상한 값(줄바꿈·따옴표·너무 긴 값)은 버린다. 로그를 위조하는 데 쓰인다.
+ * - 앱 안: request.traceId, 그리고 AsyncLocalStorage(currentTraceId())로 await 너머까지 이어진다
+ * - 나갈 때: 응답 헤더 X-Trace-Id, event 표에 넣는 데이터의 trace_id(lib/event/emitter.ts)
+ * - 보안 이벤트(lib/log/securityEvent.ts)는 request.traceId를 trace_id로 쓴다
+ */
+import { AsyncLocalStorage } from 'async_hooks';
+import { randomUUID } from 'crypto';
+import type { NextFunction, Request, Response } from 'express';
+
+const SAFE = /^[A-Za-z0-9][A-Za-z0-9._-]{7,63}$/;
+const W3C = /^[0-9a-f]{2}-([0-9a-f]{32})-[0-9a-f]{16}-[0-9a-f]{2}$/;
+const store = new AsyncLocalStorage<string>();
+
+export function pickTraceId(request: Request): string {
+  const own = (request.get('x-trace-id') || '').trim();
+  if (SAFE.test(own)) return own;
+  const tp = W3C.exec((request.get('traceparent') || '').trim());
+  if (tp && !/^0+$/.test(tp[1])) return tp[1];
+  const rid = (request.get('x-request-id') || '').trim();
+  if (SAFE.test(rid)) return rid;
+  return randomUUID().replace(/-/g, '');
+}
+
+/** 지금 요청(또는 그 요청이 시작한 비동기 작업)의 추적 번호. 요청 밖이면 undefined */
+export function currentTraceId(): string | undefined {
+  return store.getStore();
+}
+
+/** 앱 맨 앞에 끼운다(bin/lib/app.js) */
+export default function traceId(request: Request, response: Response, next: NextFunction) {
+  const id = pickTraceId(request);
+  (request as any).traceId = id;
+  response.setHeader('X-Trace-Id', id);
+  store.run(id, () => next());
+}
