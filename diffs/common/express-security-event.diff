+/**
+ * 다온마켓 ⑤ 탐지: 보안 이벤트 한 줄 로그(Spring SecurityEventLogger와 같은 키).
+ * 랩-설계.md 10절 · course/SECURITY_EVENTS.md
+ *
+ *   securityEvent.denied('access.denied.no_permission', '2-3', request, {
+ *     actor: `admin:${user.uuid}`, target: `route:${request.currentRoute.id}`, reason: '역할에 이 경로 권한이 없음'
+ *   });
+ *
+ * 넣지 않는 것: 개인정보 원문, 토큰·비밀번호, 요청 본문. target에는 ID만 넣는다.
+ */
+import { randomUUID } from 'crypto';
+import type { Request } from 'express';
+
+const WINDOW_MS = 10 * 60 * 1000;
+const recent = new Map<string, number[]>();
+
+type Fields = { actor?: string; target?: string; reason?: string };
+
+function count(key: string): number {
+  const now = Date.now();
+  const list = (recent.get(key) || []).filter((t) => now - t <= WINDOW_MS);
+  list.push(now);
+  recent.set(key, list);
+  return list.length;
+}
+
+function write(level: 'WARN' | 'INFO', event: string, lesson: string, request: Request | undefined, f: Fields) {
+  const actor = f.actor || 'anonymous';
+  const line = {
+    event,
+    lesson,
+    actor,
+    target: f.target ?? null,
+    ip: request?.ip ?? null,
+    ua: (request?.get('user-agent') || '').slice(0, 120) || null,
+    reason: f.reason ?? null,
+    count: count(`${event}|${actor}`),
+    ts: new Date().toISOString(),
+    trace_id: (request as any)?.traceId || randomUUID().replace(/-/g, '')   // express-trace-id.diff가 정한 번호
+  };
+  // 로거 이름 SECURITY. Spring 로그와 같은 방식으로 " SECURITY " 뒤의 JSON을 읽는다
+  const out = `${level} SECURITY ${JSON.stringify(line)}`;
+  if (level === 'WARN') console.warn(out); else console.info(out);
+}
+
+export const securityEvent = {
+  /** 막았을 때(WARN) */
+  denied: (event: string, lesson: string, request: Request | undefined, f: Fields = {}) =>
+    write('WARN', event, lesson, request, f),
+  /** 처리했지만 패턴이 이상할 때(INFO) */
+  suspicious: (event: string, lesson: string, request: Request | undefined, f: Fields = {}) =>
+    write('INFO', event, lesson, request, f)
+};
