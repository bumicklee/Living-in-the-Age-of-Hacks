# 11-2 Express(EverShop): 같은 교육용 기능(로그인 뒤 이동)을 처음부터 한 번 파싱으로 만든다(새 파일 둘)
# - EverShop에는 이 기능이 없다. API 경로는 /api 아래에 붙는다: GET /api/daon/go?next=/account
# - new URL(next, base) 한 번 → url.origin === base.origin → 같은 url 객체로 Location. base는 설정값(Host 헤더를 믿지 않는다)
# - 같은 HTTP 시험(교과서 예시 세 개 → Location: /, 정상 상대 경로는 그대로)으로 확인한다【실측 예정】
# - 적용: diffs/common/express-security-event.diff 다음. cd express && git apply ../diffs/s11-02/express.diff

diff --git a/packages/evershop/src/modules/customer/api/daonGo/daonGo.ts b/packages/evershop/src/modules/customer/api/daonGo/daonGo.ts
new file mode 100644
index 0000000..f71e6ef
--- /dev/null
+++ b/packages/evershop/src/modules/customer/api/daonGo/daonGo.ts
@@ -0,0 +1,37 @@
+import { securityEvent } from '../../../../lib/log/securityEvent.js';
+import { EvershopRequest } from '../../../../types/request.js';
+import { EvershopResponse } from '../../../../types/response.js';
+
+/**
+ * 다온마켓 11-2(T28) · 로그인 뒤 원래 보던 화면으로 이동: GET /api/daon/go?next=/account
+ *
+ * 주소를 한 번만 파싱하고(new URL(next, base)), 그 결과 객체로 검사와 이동을 모두 한다.
+ * - base는 설정값(DAON_SHOP_BASE_URL)이다. 요청의 Host 헤더로 만들지 않는다(4-5와 같은 이유).
+ * - 검사: url.origin === base.origin (WHATWG 파서는 「\」를 「/」처럼 읽으므로 origin 비교가 그것까지 막는다)
+ * - 이동: 같은 url 객체의 pathname + search + hash. 원래 문자열은 다시 쓰지 않는다.
+ * - 거부하면 「/」로 보내고 redirect.denied.not_allowed. 받은 주소 원문은 로그에 넣지 않는다.
+ */
+const BASE = new URL(process.env.DAON_SHOP_BASE_URL || 'http://127.0.0.1:3000/');
+
+export default (request: EvershopRequest, response: EvershopResponse) => {
+  const raw = typeof request.query.next === 'string' ? request.query.next : '';
+  let location = '/';
+  if (raw) {
+    let url: URL | null = null;
+    try {
+      url = new URL(raw, BASE);
+    } catch (e) {
+      url = null;
+    }
+    // 경로가 「//」로 시작하면(예: /.//x를 정리한 결과) 브라우저가 다른 호스트로 읽으므로 거부한다
+    if (url && url.origin === BASE.origin && !url.pathname.startsWith('//')) {
+      location = `${url.pathname}${url.search}${url.hash}`;
+    } else {
+      securityEvent.denied('redirect.denied.not_allowed', '11-2', request as any, {
+        target: 'path:/daon/go',
+        reason: url ? '허용 목록 밖 이동 주소(origin 다름)' : '허용 목록 밖 이동 주소(파싱 실패)'
+      });
+    }
+  }
+  response.redirect(302, location);
+};
