+import { requestPayment } from '../../../../lib/daon/payClient.js';
+
+/**
+ * 다온마켓 9-5(T24) Express: 주문이 들어오면 결제 요청(가짜 결제사). EverShop은 PostgreSQL event 표가 큐 역할을 한다.
+ * 재시도·서킷 브레이커·재시도 예산·죽은 이벤트는 lib/daon/payClient.ts 한 곳에서만.
+ */
+export default async function daonRequestPayment(data) {
+  await requestPayment(data, data && data.trace_id);
+}
