+++ b/packages/evershop/src/lib/daon/verifySmsCode.ts
@@ -0,0 +1,40 @@
+/**
+ * 다온마켓 9-2(T22) Express: 고위험 작업 앞 문자 본인 확인. Spring DaonStepUpClient와 같은 가짜 문자 스텁(/v1/verify/check)을 부른다.
+ *
+ * fail-closed: 확인할 수 없으면(사업자 오류·시간 초과·연결 실패) 통과가 아니라 DependencyUnavailable을 던진다.
+ * 부르는 쪽은 503 「잠시 뒤 다시 시도해 주세요」로 답하고, 번호가 틀렸을 때(400)와 섞지 않는다.
+ *
+ *   try { ok = await verifySmsCode(phone, code, request); } catch (e) { if (e instanceof DependencyUnavailable) → 503 }
+ */
+import type { Request } from 'express';
+import { securityEvent } from '../log/securityEvent.js';
+
+const SMS_URL = process.env.DAON_SMS_URL || 'http://sms-stub:8000';
+const TIMEOUT_MS = 2000;            // 시간 제한을 코드에 적는다(fetch 기본값은 제한이 없다)
+
+export class DependencyUnavailable extends Error {}
+
+export async function verifySmsCode(phone: string, code: string, request?: Request): Promise<boolean> {
+  try {
+    const res = await fetch(`${SMS_URL}/v1/verify/check`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ to: phone, code }),
+      signal: AbortSignal.timeout(TIMEOUT_MS)
+    });
+    if (res.status !== 200) throw new DependencyUnavailable(`응답 ${res.status}`);
+    const body = await res.json();
+    if (typeof body.valid !== 'boolean') throw new DependencyUnavailable('응답 형식이 다름');
+    return body.valid;
+  } catch (e) {
+    const why = e instanceof DependencyUnavailable ? e.message
+      : (e as Error).name === 'TimeoutError' ? '시간 초과' : '연결 실패';
+    // 예전 코드: catch (e) { return true; } // 장애 때 고객 불편 줄이기  ← fail-open
+    securityEvent.denied('auth.fail_closed.dependency_error', '9-2', request, {
+      actor: (request as any)?.locals?.customer?.uuid ? `customer:${(request as any).locals.customer.uuid}` : 'anonymous',
+      target: 'dependency:sms-stub',
+      reason: `본인 확인 서버 오류로 거부(${why})`
+    });
+    throw e instanceof DependencyUnavailable ? e : new DependencyUnavailable(why);
+  }
+}
