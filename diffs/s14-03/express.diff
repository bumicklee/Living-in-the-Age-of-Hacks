+import { isDegraded } from '../../../../lib/secureKit/degradedMode.js';
+import { SERVICE_UNAVAILABLE } from '../../../../lib/util/httpStatus.js';
+import { EvershopRequest } from '../../../../types/request.js';
+
+/**
+ * 다온마켓 14-3(Express): 축소 운영이면 돈이 나가는 관리자 기능(환불 createOrderRefund·결제 확정 captureOrder)을 503 + 안내 문구로 멈춘다.
+ * 주문 접수·조회는 그대로(「주문은 받고 정산은 멈춘다」). 역할 검사(auth) 뒤에 돈다.
+ */
+const MONEY_OUT = new Set(['createOrderRefund', 'captureOrder']);
+
+export default async (request: EvershopRequest, response, next) => {
+  const routeId = request.currentRoute?.id;
+  if (!routeId || !MONEY_OUT.has(routeId) || request.method !== 'POST' || !(await isDegraded('payment'))) {
+    next();
+    return;
+  }
+  response.setHeader('Retry-After', '300');
+  response.status(SERVICE_UNAVAILABLE);
+  response.json({ error: { status: SERVICE_UNAVAILABLE, message: '결제 확인이 늦어지고 있어 환불·정산을 잠시 멈췄습니다(축소 운영)' } });
+};
