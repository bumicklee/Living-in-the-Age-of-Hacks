@@ -0,0 +1,19 @@
+/**
+ * 다온마켓 14-3(Express): 결제사 호출의 동시 실행 상한(작은 세마포어, 벌크헤드).
+ * 자리가 없으면 기다리지 않고 onFull()을 돌려준다. 결제사가 느려도 다른 요청(상품 목록 등)이 쓸 자리가 남는다.
+ * Node는 스레드 대신 이벤트 루프라 「스레드 고갈」은 없지만, 소켓·DB 연결·메모리가 같은 식으로 묶인다.
+ */
+export const PAYMENT_SLOTS = 6;
+let inFlight = 0;
+
+export async function withPaymentSlot<T>(fn: () => Promise<T>, onFull: () => T): Promise<T> {
+  if (inFlight >= PAYMENT_SLOTS) {
+    return onFull();                 // 기다리지 않는다
+  }
+  inFlight += 1;
+  try {
+    return await fn();
+  } finally {
+    inFlight -= 1;
+  }
+}
