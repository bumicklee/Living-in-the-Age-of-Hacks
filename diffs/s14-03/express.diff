+import { select } from '@evershop/postgres-query-builder';
+import { pool } from '../postgres/connection.js';
+
+/**
+ * 다온마켓 14-3(Express): 축소 운영 값. Spring은 Redis mall:mode:payment, EverShop은 상점 설정 표(setting)의 daon_mode_<기능>.
+ * 바꾸는 것은 상점 설정 저장(saveSetting)이라 13-6 권한 상승(store-settings)을 거친다. 매 요청 읽는다.
+ * 값을 못 읽으면 평소 모드로 본다(멀쩡한 결제를 멈추지 않는다. 돈이 나가는 쪽은 승인 서비스 브레이커가 따로 지킨다).
+ */
+export async function isDegraded(feature: string): Promise<boolean> {
+  try {
+    const row = await select().from('setting').where('name', '=', `daon_mode_${feature}`).load(pool);
+    return row?.value === 'degraded';
+  } catch (e) {
+    return false;
+  }
+}
