+  """
+  다온마켓 5-4: 가린 전화번호(010-****-0101). 목록·상세는 이 값만 쓴다
+  """
+  phone: String
+  """
+  다온마켓 5-4: 전화번호 원문. pii:reveal 권한이 있는 관리자만 받는다
+  """
+  phoneRaw: String
   updateMetafieldsApi: String!
 }
 
