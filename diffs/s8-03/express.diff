@@ -0,0 +1,56 @@
+/**
+ * 다온마켓 8-3: 관리자 조회 감사 로그(AUDIT). Spring의 @Audited·AuditAspect와 같은 필드(docs/audit-schema.yaml).
+ *
+ *   customers: async (_, { filters = [] }, context) => audit.collection(root, 'customer.list', 'customer', context)
+ *
+ * 한 줄 JSON 앞에 「AUDIT 」 표식을 붙여 표준 출력으로 낸다(수집기가 stream=audit으로 읽을 수 있게).
+ * 넣지 않는 것: 이름·전화·주소, 토큰, 요청·응답 본문. count는 실제로 돌려준 건수.
+ */
+import { currentTraceId } from '../middlewares/traceId.js';
+import { securityEvent } from './securityEvent.js';
+
+const BULK = Number(process.env.DAON_AUDIT_BULK_THRESHOLD || 30);
+
+type Ctx = { user?: { uuid?: string } } | undefined;
+
+function write(action: string, target: string, count: number, context: Ctx, result = 'ok') {
+  const line = {
+    ts: new Date().toISOString(),
+    trace_id: currentTraceId() || null,
+    actor: context?.user?.uuid ? `admin:${context.user.uuid}` : 'anonymous',
+    action,
+    target,
+    count,
+    reason: null,
+    result
+  };
+  console.info(`AUDIT ${JSON.stringify(line)}`);
+  if (result === 'ok' && count >= BULK) {
+    securityEvent.suspicious('data.read.bulk', '8-3', undefined, {
+      actor: line.actor,
+      target: `action:${action}`,
+      reason: `한 번에 기준 건수(${BULK}건) 이상 조회`
+    });
+  }
+}
+
+export const audit = {
+  /** 값 하나(상세 조회) */
+  one: (action: string, target: string, found: unknown, context: Ctx) =>
+    write(action, target, found ? 1 : 0, context),
+  /** 목록: items()가 돌려준 건수를 센다(전체 건수 total이 아니다) */
+  collection: <T extends { items: () => Promise<unknown[]> }>(root: T, action: string, resource: string, context: Ctx): T => {
+    const items = root.items.bind(root);
+    root.items = async () => {
+      try {
+        const rows = await items();
+        write(action, `${resource}:list`, rows.length, context);
+        return rows;
+      } catch (e) {
+        write(action, `${resource}:list`, 0, context, 'error');
+        throw e;
+      }
+    };
+    return root;
+  }
+};
