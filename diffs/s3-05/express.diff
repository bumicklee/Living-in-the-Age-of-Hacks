# 3-5 Express(EverShop)에서 고칠 곳: 보안 헤더와 세션 쿠키 속성(점검표 E02·E03·E20)
# - E20: X-Powered-By: Express 끄기(app.js), 모든 응답에 보안 헤더. 상점 화면은 하이드레이션용 인라인 스크립트를 써서
#        script-src는 Content-Security-Policy-Report-Only로 먼저 보고만 받는다(Spring 관리자 화면은 nginx에서 막는다).
# - E03: 세션 쿠키 sameSite 'lax', 빈 세션 저장 안 함(saveUninitialized: false)
# - E02: 운영 모드에서 쿠키 secure: true(앞단 프록시 수는 TRUST_PROXY_HOPS)
# - 앞 수업의 common/express-trace-id.diff 뒤에 적용: cd express && git apply ../diffs/s3-05/express.diff
#   확인: curl -sI http://127.0.0.1:3000/ 의 헤더·Set-Cookie

diff --git a/packages/evershop/src/bin/lib/addDefaultMiddlewareFuncs.ts b/packages/evershop/src/bin/lib/addDefaultMiddlewareFuncs.ts
index d7a5abd..989b3f2 100644
--- a/packages/evershop/src/bin/lib/addDefaultMiddlewareFuncs.ts
+++ b/packages/evershop/src/bin/lib/addDefaultMiddlewareFuncs.ts
@@ -53,6 +53,21 @@ export function addDefaultMiddlewareFuncs(app) {
       debug(message);
     });
   });
+  // 다온마켓 3-5(E20): 보안 헤더를 모든 응답에. 상점 화면은 하이드레이션용 인라인 스크립트를 쓰므로
+  // script-src는 먼저 보고만 받고(Report-Only) 고친 뒤 막는다. 깨지지 않는 지시어는 바로 건다
+  app.use((request, response, next) => {
+    response.setHeader('X-Content-Type-Options', 'nosniff');
+    response.setHeader('Referrer-Policy', 'strict-origin-when-cross-origin');
+    response.setHeader(
+      'Content-Security-Policy',
+      "object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
+    );
+    response.setHeader(
+      'Content-Security-Policy-Report-Only',
+      "script-src 'self'"
+    );
+    next();
+  });
   // Add public static middleware
   app.use(publicStatic);
   // Add theme public static middleware
@@ -76,15 +91,19 @@ export function addDefaultMiddlewareFuncs(app) {
           }),
     secret: cookieSecret,
