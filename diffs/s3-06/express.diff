# 3-6 Express(EverShop)에서 고칠 곳: 업로드 이름·내용·서빙·경로(점검표 E13·E14·E15)
# - E13: 형식은 파일 앞 바이트로 정한다(CustomMemoryStorage). 요청 mimetype·확장자는 믿지 않고, 저장 확장자도 내용으로 정한다.
#        media 경로(사람이 올린 파일)는 그림 확장자만 내준다(static.ts). svg·js는 빌드 결과에서만.
# - E14: 저장 이름은 무작위 ID(generateFileName.js). 같은 이름 덮어쓰기가 사라진다.
# - E15: 경로 검사에 구분자까지 비교(validatePath.js).
# - ⑤ 탐지 upload.rejected.type. 먼저 diffs/common/express-security-event.diff를 넣는다.
# - 적용: cd express && git apply ../diffs/s3-06/express.diff

diff --git a/packages/evershop/src/lib/middlewares/static.ts b/packages/evershop/src/lib/middlewares/static.ts
index 53cab34..5f22951 100644
--- a/packages/evershop/src/lib/middlewares/static.ts
+++ b/packages/evershop/src/lib/middlewares/static.ts
@@ -45,6 +45,9 @@ const ALLOWED_EXTENSIONS = [
   '.map'
 ];
 
+// 다온마켓 3-6(E13): 사람이 올린 파일(media)은 그림만 내준다. svg·js·css처럼 브라우저가 실행·해석하는 형식은 빌드 결과에만
+const MEDIA_EXTENSIONS = ['.jpg', '.jpeg', '.png', '.gif', '.webp', '.avif'];
+
 /**
  * Checks if a path exists and is accessible
  * @param {string} path - Path to check
@@ -129,7 +132,11 @@ export default async (
 
   // Check media path
   const mediaPath = join(CONSTANTS.MEDIAPATH, path);
-  if ((await pathExists(mediaPath)) && (await isValidFile(mediaPath))) {
+  if (
+    (await pathExists(mediaPath)) &&
+    (await isValidFile(mediaPath)) &&
+    MEDIA_EXTENSIONS.includes(extname(mediaPath).toLowerCase())
+  ) {
     return staticMiddleware(CONSTANTS.MEDIAPATH, staticMiddlewareOptions)(
       request,
       response,
diff --git a/packages/evershop/src/modules/cms/services/CustomMemoryStorage.js b/packages/evershop/src/modules/cms/services/CustomMemoryStorage.js
index 8c9beac..0306891 100644
--- a/packages/evershop/src/modules/cms/services/CustomMemoryStorage.js
+++ b/packages/evershop/src/modules/cms/services/CustomMemoryStorage.js
@@ -1,3 +1,14 @@
+import { securityEvent } from '../../../lib/log/securityEvent.js';
+
+// 다온마켓 3-6(E13): 형식은 파일 앞 바이트(서명)로 정한다. 요청의 mimetype·확장자는 믿지 않는다. SVG·HTML은 받지 않는다
+function sniffImageExtension(b) {
+  if (b.length >= 8 && b.readUInt32BE(0) === 0x89504e47 && b.readUInt32BE(4) === 0x0d0a1a0a) return 'png';
+  if (b.length >= 3 && b[0] === 0xff && b[1] === 0xd8 && b[2] === 0xff) return 'jpg';
+  if (b.length >= 6 && (b.toString('latin1', 0, 6) === 'GIF87a' || b.toString('latin1', 0, 6) === 'GIF89a')) return 'gif';
+  if (b.length >= 12 && b.toString('latin1', 0, 4) === 'RIFF' && b.toString('latin1', 8, 12) === 'WEBP') return 'webp';
+  return null;
+}
+
 function CustomMemoryStorage(opts) {
   this.getFilename = opts.filename;
   // Optional (file) => MB. When provided, the file is rejected AS IT STREAMS
@@ -11,7 +22,7 @@ CustomMemoryStorage.prototype._handleFile = function _handleFile(
   file,
   cb
 ) {
-  const filename = this.getFilename(file.originalname);
+  const getFilename = this.getFilename;
   const limitMb = this.getFileSizeLimitMb
     ? this.getFileSizeLimitMb(file)
     : undefined;
@@ -44,10 +55,23 @@ CustomMemoryStorage.prototype._handleFile = function _handleFile(
   file.stream.on('end', () => {
     if (!aborted) {
       const buffer = Buffer.concat(chunks);
+      const extension = sniffImageExtension(buffer);
+      if (!extension) {
+        securityEvent.denied('upload.rejected.type', '3-6', req, {
+          actor: req.locals?.user?.uuid ? `admin:${req.locals.user.uuid}` : undefined,
+          target: 'upload:-',
+          reason: '내용이 허용 형식이 아님'
+        });
+        const error = new Error('The file content is not an allowed image');
+        error.code = 'LIMIT_UNEXPECTED_FILE';
+        cb(error);
+        return;
+      }
       cb(null, {
         buffer,
         size: buffer.length,
-        filename
+        mimetype: `image/${extension === 'jpg' ? 'jpeg' : extension}`,
+        filename: getFilename(file.originalname, extension)
       });
     }
   });
diff --git a/packages/evershop/src/modules/cms/services/generateFileName.js b/packages/evershop/src/modules/cms/services/generateFileName.js
index 35dc514..b74cbe3 100644
--- a/packages/evershop/src/modules/cms/services/generateFileName.js
+++ b/packages/evershop/src/modules/cms/services/generateFileName.js
@@ -1,9 +1,5 @@
-import path from 'path';
+import { randomUUID } from 'crypto';
 
-export const generateFileName = (originalname) => {
-  const extension = path.extname(originalname);
-  const name = path.basename(originalname, extension);
-  // Replace special characters and white spaces with a -
-  const fileName = name.replace(/[^a-z0-9]/gi, '-').toLowerCase();
-  return `${fileName}${extension}`;
-};
+// 다온마켓 3-6(E13·E14): 저장 이름은 서버가 정한다. 무작위 ID + 「내용으로 정한」 확장자.
+// 올린 이름(originalname)은 쓰지 않는다: 같은 이름 덮어쓰기와 경로·특수 문자로 위치를 바꾸는 시도가 함께 사라진다.
+export const generateFileName = (originalname, extension) => `${randomUUID()}.${extension}`;
