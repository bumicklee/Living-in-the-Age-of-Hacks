+++ b/packages/evershop/src/lib/crypto/fieldCrypto.ts
@@ -0,0 +1,123 @@
+import {
+  createCipheriv,
+  createDecipheriv,
+  randomBytes
+} from 'node:crypto';
+import { warning } from '../log/logger.js';
+
+/**
+ * 다온마켓 5-3: 개인정보 칸(전화번호)용 봉투 암호화 도우미.
+ *
+ * 값마다 새 데이터 키(DEK)를 만들어 AES-256-GCM으로 값을 암호화하고,
+ * DEK는 키 암호화 키(KEK)로 다시 감싸서 같이 저장한다.
+ * 저장 형식: enc:1:<kek id>:<감싼 DEK>:<암호문>   (각 조각은 base64url, iv·tag 포함)
+ *
+ * - KEK는 환경 변수로 받는다(DAON_PII_KEK = base64 32바이트, DAON_PII_KEK_ID 기본 k1).
+ *   A4(OpenBao)가 붙으면 getKek()만 Transit 호출로 바꾸면 된다.
+ * - 칸 이름(context)을 AAD로 묶어서 다른 칸의 암호문을 옮겨 붙이면 풀리지 않는다.
+ * - 키가 없으면 평문으로 저장하지 않고 예외를 던진다(실패하면 닫는다).
+ * - enc:1: 로 시작하지 않는 값은 옛 평문으로 보고 그대로 돌려준다(점진 전환용).
+ */
+const PREFIX = 'enc:1:';
+const IV_LENGTH = 12;
+const TAG_LENGTH = 16;
+
+function getKek(kid: string): Buffer {
+  const currentId = process.env.DAON_PII_KEK_ID || 'k1';
+  const raw = kid === currentId ? process.env.DAON_PII_KEK : undefined;
+  const key = raw ? Buffer.from(raw, 'base64') : null;
+  if (!key || key.length !== 32) {
+    throw new Error(`PII key ${kid} is not configured`);
+  }
+  return key;
+}
+
+function seal(key: Buffer, plain: Buffer, aad: Buffer): Buffer {
+  const iv = randomBytes(IV_LENGTH);
+  const cipher = createCipheriv('aes-256-gcm', key, iv);
+  cipher.setAAD(aad);
+  const body = Buffer.concat([cipher.update(plain), cipher.final()]);
+  return Buffer.concat([iv, cipher.getAuthTag(), body]);
+}
+
+function open(key: Buffer, sealed: Buffer, aad: Buffer): Buffer {
+  const iv = sealed.subarray(0, IV_LENGTH);
+  const tag = sealed.subarray(IV_LENGTH, IV_LENGTH + TAG_LENGTH);
+  const body = sealed.subarray(IV_LENGTH + TAG_LENGTH);
+  const decipher = createDecipheriv('aes-256-gcm', key, iv);
+  decipher.setAAD(aad);
+  decipher.setAuthTag(tag);
+  return Buffer.concat([decipher.update(body), decipher.final()]);
+}
+
+export function isEncrypted(value: unknown): boolean {
+  return typeof value === 'string' && value.startsWith(PREFIX);
+}
+
+export function encryptField(
+  value: string | null | undefined,
+  context: string
+): string | null | undefined {
+  if (value === null || value === undefined || value === '') {
+    return value;
+  }
+  if (isEncrypted(value)) {
+    return value; // 이미 암호문이면 다시 감싸지 않는다
+  }
+  const kid = process.env.DAON_PII_KEK_ID || 'k1';
+  const kek = getKek(kid);
+  const aad = Buffer.from(context);
+  const dek = randomBytes(32);
+  const wrapped = seal(kek, dek, aad);
+  const payload = seal(dek, Buffer.from(value, 'utf8'), aad);
+  return `${PREFIX}${kid}:${wrapped.toString('base64url')}:${payload.toString('base64url')}`;
+}
+
+export function decryptField(
+  value: string | null | undefined,
+  context: string
+): string | null | undefined {
+  if (!isEncrypted(value)) {
+    return value;
+  }
+  try {
+    const [kid, wrapped, payload] = (value as string)
+      .slice(PREFIX.length)
+      .split(':');
+    const aad = Buffer.from(context);
+    const dek = open(getKek(kid), Buffer.from(wrapped, 'base64url'), aad);
+    return open(dek, Buffer.from(payload, 'base64url'), aad).toString('utf8');
+  } catch (e) {
+    // 풀지 못하면 값을 만들어 내지 않는다. 원인(키 없음·변조)은 로그에만 남긴다
+    warning(`crypto.decrypt.failed ${context}: ${(e as Error).message}`);
+    return null;
+  }
+}
+
+/** 주소 행의 telephone만 암호화한 복사본(table: 'order_address' | 'customer_address'). */
+export function protectAddressRow<T extends Record<string, any>>(
+  table: string,
+  row: T
+): T {
+  if (!row || row.telephone === undefined) {
+    return row;
+  }
+  return {
+    ...row,
+    telephone: encryptField(row.telephone, `${table}.telephone`)
+  };
+}
+
+/** 주소 행의 telephone을 푼 복사본. 암호문이 아니면 그대로 돌려준다. */
+export function revealAddressRow<T extends Record<string, any> | null>(
+  table: string,
+  row: T
+): T {
+  if (!row || row.telephone === undefined) {
+    return row;
+  }
+  return {
+    ...row,
+    telephone: decryptField(row.telephone, `${table}.telephone`)
+  };
+}
