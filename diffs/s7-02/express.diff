# 7-2 Express(EverShop)에서 고칠 곳: SBOM 만들기와 높음 이상 런타임 권고(점검표 F33·F34 Express 쪽)
# - `npm run sbom`이 CycloneDX SBOM(JSON)을 build/sbom/evershop.cdx.json 으로 만든다(devDependency @cyclonedx/cyclonedx-npm, lock 파일만 읽는다).
# - `overrides`: 최초 점검 5절의 높음 이상 런타임 권고 네 개를 고친 버전으로 올린다(body-parser·multer·undici는 직접 의존, follow-redirects는 간접 의존). 2026-11-09 npm 레지스트리에서 확인한 버전이다.
# - 쓰지 않는 session-file-store(packages/evershop/package.json)는 코드 어디에서도 불러오지 않는다. 빼는 것은 lock 파일을 다시 만들 때 함께 한다(이 diff는 lock 파일을 건드리지 않는다).
# - 적용: cd express && git apply ../diffs/s7-02/express.diff && npm install   (lock 파일이 바뀐다. 적용 뒤 기동·정상 시험을 확인한다)
# - 빌드 도구에만 걸린 권고(관리자 웹·Express devDependencies 대부분)는 7-5의 CI에서 다룬다.

diff --git a/package.json b/package.json
index 8930c0c..2dde542 100644
--- a/package.json
+++ b/package.json
@@ -31,12 +31,14 @@
     "test:e2e:report": "npm run test:report --prefix tests/e2e",
     "lint": "eslint --fix --ext .js,.jsx,.ts,.tsx ./packages",
     "release:preflight": "node scripts/release-preflight.mjs",
+    "sbom": "cyclonedx-npm --package-lock-only --ignore-npm-errors --output-format JSON --output-file build/sbom/evershop.cdx.json",
     "generate:address-formats": "node scripts/address-formats/generate.mjs",
     "prepare": "husky install"
   },
   "author": "The Nguyen (https://evershop.io)",
   "license": "GNU GENERAL PUBLIC LICENSE 3.0",
   "devDependencies": {
+    "@cyclonedx/cyclonedx-npm": "^4.1.2",
     "@parcel/watcher": "^2.5.1",
     "@playwright/test": "^1.59.1",
     "@swc/cli": "^0.7.7",
@@ -72,6 +74,10 @@
   },
   "overrides": {
     "react": "^19.0.0",
-    "react-dom": "^19.0.0"
+    "react-dom": "^19.0.0",
