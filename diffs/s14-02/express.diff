# 14-2 Express(EverShop): 같은 A11 잠금 버킷에 PostgreSQL 덤프를 올리는 백업 작업(backup-job-pg)을 더한다
# - 새 infra/backup/backup-pg.sh: pg_dump → 압축 → sha256 → daon-backup/postgres/ (backup-writer, 올리기만). 해시·복구 시점 메타데이터
# - 새 infra/backup/Dockerfile.pg: postgres:16.15-alpine + mc(정적 빌드)
# - infra/compose.a11.yml: backup-vault·backup-audit·backup-init을 express 프로필에도 켜고, backup-init의 MySQL·앱 MinIO 의존을 required: false로
#   (backup-init.sh는 이름 db·minio가 없으면 그 단계를 건너뛴다). backup-job-pg 서비스 추가
# - 한계: PostgreSQL 계정은 원본 기본값(postgres)이다. 회사에서는 읽기 전용 역할을 따로 만든다. 복구 훈련(make restore-drill)은 MySQL만 본다
# - 적용: 14-2 완료 지점의 랩 저장소 맨 위에서(express/ 안이 아니다). git apply diffs/s14-02/express.diff

diff --git a/infra/backup/Dockerfile.pg b/infra/backup/Dockerfile.pg
new file mode 100644
index 0000000..b47f404
--- /dev/null
+++ b/infra/backup/Dockerfile.pg
@@ -0,0 +1,8 @@
+# 다온마켓 14-2 Express: PostgreSQL 클라이언트(pg_dump) + MinIO 클라이언트(mc, 정적 빌드라 그대로 옮긴다)
+FROM pgsty/minio:RELEASE.2026-08-04T00-00-00Z AS mc
+RUN cp "$(command -v mc)" /tmp/mc
+
+FROM postgres:16.15-alpine
+COPY --from=mc /tmp/mc /usr/local/bin/mc
+ENV MC_CONFIG_DIR=/tmp/.mc
+USER postgres
diff --git a/infra/backup/backup-pg.sh b/infra/backup/backup-pg.sh
new file mode 100644
index 0000000..4ae98ef
--- /dev/null
+++ b/infra/backup/backup-pg.sh
@@ -0,0 +1,17 @@
+#!/bin/sh
+# 다온마켓 14-2 Express · EverShop(PostgreSQL) 백업 한 번: pg_dump → 압축 → sha256 → 같은 잠금 버킷 postgres/ (backup-writer, 올리기만)
+# MySQL 쪽 backup.sh와 같은 규칙: 해시·복구 시점 메타데이터, 실패하면 아무것도 올리지 않고 0이 아닌 값으로 끝난다.
+set -eu
+umask 077
+TS=$(date -u +%Y-%m-%dT%H%M%SZ)
+SNAPSHOT_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)
+WORK=$(mktemp -d)
+trap 'rm -rf -- "$WORK"' EXIT
+NAME="evershop-$TS.sql.gz"
+pg_dump --no-owner > "$WORK/dump.sql"            # 파이프 대신 파일로: sh에는 pipefail이 없어 pg_dump 실패를 놓칠 수 있다
+gzip -c "$WORK/dump.sql" > "$WORK/$NAME"
+[ -s "$WORK/$NAME" ] || { echo "[14-2] 덤프가 비었습니다" >&2; exit 1; }
+SUM=$(sha256sum "$WORK/$NAME" | cut -d' ' -f1)
+export MC_HOST_vault="http://$(cat "$WRITER_DIR/access_key"):$(cat "$WRITER_DIR/secret_key")@${VAULT_URL}"
+mc cp --quiet --attr "sha256=${SUM};snapshot-at=${SNAPSHOT_AT}" "$WORK/$NAME" "${TARGET}${NAME}" >/dev/null
+echo "[14-2] PostgreSQL 백업 올림: ${TARGET}${NAME} (잠금 버킷, backup-writer)"
