@@ -125,6 +125,41 @@ services:
     mem_limit: 128m
     networks: [data, backup]                                         # DB에 붙어 덤프하고(data), backup 망으로 올린다. 앱 MinIO 계정은 없다
 
+  backup-job-pg:
+    # Express(EverShop) DB 백업: PostgreSQL 덤프 → 같은 잠금 버킷 postgres/ (backup-writer, 올리기만)
+    profiles: [express]
+    build:
+      context: ./backup
+      dockerfile: Dockerfile.pg
+    image: daon/backup-pg:dev
+    entrypoint: ["/bin/sh", "-c"]
+    command:
+      - |
+        while true; do
+          /backup/backup-pg.sh || echo "[14-2] PostgreSQL 백업 실패: 종료 코드 $$?"
+          sleep $${DAON_BACKUP_INTERVAL:-300}
+        done
+    environment:
+      VAULT_URL: backup-vault:9000
+      WRITER_DIR: /run/backup-writer
+      TARGET: vault/daon-backup/postgres/
+      PGHOST: postgres
+      PGUSER: postgres                                                 # [원본 기본값] 회사에서는 읽기 전용 역할을 따로 둔다
+      PGPASSWORD: postgres
+      PGDATABASE: postgres
+      DAON_BACKUP_INTERVAL: ${DAON_BACKUP_INTERVAL:-300}
+      MC_CONFIG_DIR: /tmp/.mc
+      TZ: Asia/Seoul
+    volumes:
+      - ./backup/backup-pg.sh:/backup/backup-pg.sh:ro
+      - backup-writer-creds:/run/backup-writer:ro
+    depends_on:
+      postgres: { condition: service_healthy }
+      backup-init: { condition: service_completed_successfully }
+    restart: unless-stopped
+    mem_limit: 128m
+    networks: [data, backup]
+
