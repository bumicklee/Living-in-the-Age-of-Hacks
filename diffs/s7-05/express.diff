# 7-5 Express(EverShop)에서 고칠 곳: 이미지 빌드 파일(점검표 E25)
# - `npm install`을 lock 파일 그대로 까는 `npm ci`로 바꾼다(빌드할 때마다 다른 버전이 들어오지 않게). 7-2의 package.json 변경(diffs/s7-02) 뒤에는 lock 파일을 다시 만들어 함께 커밋해야 한다.
# - 실행 사용자를 root에서 node로 바꾼다. 업로드(media)·설정(config) 폴더 소유권을 먼저 맞춘다.
# - 같은 CI 파일(.gitea/workflows/build.yml)에 Express 이미지 빌드 작업을 더하는 일은 랩의 수업 카드를 본다(이 diff는 빌드 파일만).
# - 적용: cd express && git apply ../diffs/s7-05/express.diff

diff --git a/Dockerfile b/Dockerfile
index d73da60..c42c953 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -37,7 +37,7 @@ RUN mkdir -p config themes extensions public media
 
 # compile: TypeScript src -> dist via swc (what `build` and `start` execute).
 # build:   webpack bundles for the storefront and admin.
-RUN npm install \
+RUN npm ci --no-audit --no-fund \
   && npm run compile \
   && npm run compile:db \
   && npm run build
@@ -46,4 +46,8 @@ RUN npm install \
 # The previous EXPOSE 80 matched neither the default nor docker-compose.yml.
 EXPOSE 3000
 
+# 7-5(E25): root로 돌지 않는다. 업로드·설정 폴더의 소유자를 node로 맞춘 뒤 실행 사용자를 바꾼다
+RUN chown -R node:node /app/config /app/themes /app/extensions /app/public /app/media
+USER node
+
 CMD ["npm", "run", "start"]
