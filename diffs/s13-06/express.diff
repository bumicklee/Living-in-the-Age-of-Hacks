@@ -0,0 +1,16 @@
+import type { PoolClient } from 'pg';
+
+/**
+ * 다온마켓 13-6: 시간 제한 권한 상승(JIT). 관리자마다 묶음(grp)별 만료 시각 한 줄.
+ * 승인 서비스(A10)가 서명한 권한 상승 토큰을 확인한 뒤에만 쓴다(daonElevationActivate). 사유는 승인 서비스 표에만 있다.
+ * 버전 1.0.3은 5-2 diff(token_version)가 쓴다.
+ */
+export default async (connection: PoolClient) => {
+  await connection.query(`CREATE TABLE IF NOT EXISTS daon_ops_elevation (
+    admin_user_id INT NOT NULL REFERENCES admin_user (admin_user_id) ON DELETE CASCADE,
+    grp VARCHAR(40) NOT NULL,
+    approval VARCHAR(40) NOT NULL,
+    expires_at TIMESTAMPTZ NOT NULL,
+    PRIMARY KEY (admin_user_id, grp)
+  )`);
+};
