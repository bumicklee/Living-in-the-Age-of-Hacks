+import { select } from '@evershop/postgres-query-builder';
+import { securityEvent } from '../../../../lib/log/securityEvent.js';
+import { pool } from '../../../../lib/postgres/connection.js';
+import { FORBIDDEN } from '../../../../lib/util/httpStatus.js';
+import { EvershopRequest } from '../../../../types/request.js';
+
+/**
+ * 다온마켓 13-6(Express, E21): 역할 검사(auth)를 지난 요청도 고위험 기능이면 DB에서 권한 상승 만료 시각을 다시 읽는다.
+ * 토큰 속 정보(역할·권한)를 그대로 믿지 않는다. 살아 있는 권한 상승이 없으면 403 + ops.denied.no_elevation.
+ * EverShop에는 관리자 계정·역할 관리 API가 없어서, 상점 설정 저장(saveSetting: 결제·배송 설정 포함)을 고위험 묶음으로 둔다.
+ */
+const HIGH_RISK: Record<string, string> = { saveSetting: 'store-settings' };
+
+export default async (request: EvershopRequest, response, next) => {
+  const routeId = request.currentRoute?.id;
+  const group = routeId ? HIGH_RISK[routeId] : undefined;
+  const user = request.getCurrentUser();
+  if (!group || !user || request.method !== 'POST') {
+    next();
+    return;
+  }
+  const row = await select()
+    .from('daon_ops_elevation')
+    .where('admin_user_id', '=', (user as any).admin_user_id)
+    .and('grp', '=', group)
+    .and('expires_at', '>', new Date())
+    .load(pool);
+  if (row) {
+    next();
+    return;
+  }
+  securityEvent.denied('ops.denied.no_elevation', '13-6', request, {
+    actor: `admin:${user.uuid}`,
+    target: `route:${routeId}`,
+    reason: `고위험 기능(${group})을 권한 상승 없이 호출`
+  });
+  response.status(FORBIDDEN);
+  response.json({ error: { status: FORBIDDEN, message: '권한 상승(사유·다른 사람 승인·시간 제한)이 필요합니다' } });
+};
diff --git a/packages/evershop/src/modules/auth/migration/Version-1.0.4.ts b/packages/evershop/src/modules/auth/migration/Version-1.0.4.ts
