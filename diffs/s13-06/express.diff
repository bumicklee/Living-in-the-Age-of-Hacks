--- /dev/null
+++ b/packages/evershop/src/modules/auth/api/daonElevationActivate/daonElevationActivate.ts
@@ -0,0 +1,33 @@
+import { insertOnUpdate } from '@evershop/postgres-query-builder';
+import { securityEvent } from '../../../../lib/log/securityEvent.js';
+import { pool } from '../../../../lib/postgres/connection.js';
+import { verifyApprovalToken } from '../../../../lib/secureKit/approval.js';
+import { FORBIDDEN, OK } from '../../../../lib/util/httpStatus.js';
+import { EvershopRequest } from '../../../../types/request.js';
+
+/**
+ * 다온마켓 13-6(Express): 승인 서비스가 서명한 권한 상승 토큰(누가·묶음·만료)을 확인하고 만료 시각까지 켠다.
+ * 토큰의 주인(sub)이 지금 로그인한 관리자(메일)와 같아야 한다. 승인(다른 사람)은 승인 서비스에서 한다.
+ */
+export default async (request: EvershopRequest, response, next) => {
+  const user = request.getCurrentUser();
+  const { token, group } = request.body || {};
+  const p = verifyApprovalToken(token, 'ops-elevation', String(group));
+  if (!p || !user || p.sub !== user.email) {
+    securityEvent.denied('ops.denied.no_elevation', '13-6', request, {
+      actor: `admin:${user?.uuid ?? 'unknown'}`, target: 'elevation:token', reason: '권한 상승 토큰이 없거나 서명·주인이 맞지 않음'
+    });
+    response.status(FORBIDDEN);
+    response.json({ error: { status: FORBIDDEN, message: 'Forbidden' } });
+    return;
+  }
+  const expiresAt = new Date(Number(p.exp) * 1000);
+  await insertOnUpdate('daon_ops_elevation', ['admin_user_id', 'grp'])
+    .given({ admin_user_id: (user as any).admin_user_id, grp: p.group, approval: p.approval, expires_at: expiresAt })
+    .execute(pool);
+  securityEvent.suspicious('ops.elevation.granted', '13-6', request, {
+    actor: `admin:${user.uuid}`, target: `approval:${p.approval}`, reason: `승인된 권한 상승(${p.group})`
+  });
+  response.status(OK);
+  response.json({ data: { group: p.group, expiresAt: expiresAt.toISOString() } });
+};
