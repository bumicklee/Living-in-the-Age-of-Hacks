diff --git a/packages/evershop/src/modules/auth/migration/Version-1.0.3.ts b/packages/evershop/src/modules/auth/migration/Version-1.0.3.ts
new file mode 100644
index 0000000..eb99280
--- /dev/null
+++ b/packages/evershop/src/modules/auth/migration/Version-1.0.3.ts
@@ -0,0 +1,13 @@
+import type { PoolClient } from 'pg';
+import { execute } from '@evershop/postgres-query-builder';
+
+/**
+ * 다온마켓 5-2: 관리자 토큰 버전 칸. 기존 계정은 0에서 시작한다.
+ * 이 칸이 없던 때 나간 토큰에는 버전이 없으므로 적용 뒤 한 번 다시 로그인해야 한다.
+ */
+export default async (connection: PoolClient) => {
+  await execute(
+    connection,
+    `ALTER TABLE "admin_user" ADD COLUMN IF NOT EXISTS "token_version" INT NOT NULL DEFAULT 0;`
+  );
+};
diff --git a/packages/evershop/src/modules/auth/services/adminTokenVersion.ts b/packages/evershop/src/modules/auth/services/adminTokenVersion.ts
new file mode 100644
index 0000000..3ffc830
--- /dev/null
+++ b/packages/evershop/src/modules/auth/services/adminTokenVersion.ts
@@ -0,0 +1,31 @@
+import { execute, select } from '@evershop/postgres-query-builder';
+import { pool } from '../../../lib/postgres/connection.js';
+
+/**
+ * 다온마켓 5-2: 관리자 토큰 버전.
+ * 토큰을 만들 때 DB의 token_version을 넣고, 확인할 때 DB의 현재 값과 같은지 본다.
+ * 권한을 바꾸거나 계정을 잠글 때 bumpAdminTokenVersion을 부르면 이전 토큰이 한꺼번에 무효가 된다.
+ */
+export async function assertAdminTokenVersion(
+  adminUserId: number,
+  tokenVersion: number | undefined
+): Promise<void> {
+  const adminUser = await select('token_version')
+    .from('admin_user')
+    .where('admin_user_id', '=', adminUserId)
+    .and('status', '=', 1)
+    .load(pool);
+  // 계정이 없거나 잠겼거나 버전이 다르면 같은 문구로 거부한다(이유를 알려 주지 않는다)
+  if (!adminUser || adminUser.token_version !== tokenVersion) {
+    throw new Error('Invalid token');
+  }
+}
+
+export async function bumpAdminTokenVersion(
+  adminUserId: number
+): Promise<void> {
+  await execute(
+    pool,
+    `UPDATE "admin_user" SET "token_version" = "token_version" + 1 WHERE "admin_user_id" = ${Number(adminUserId)}`
+  );
+}
