 export function addDefaultMiddlewareFuncs(app) {
+  // 다온마켓 2-6: Host 허용 목록. 맨 앞에서 검사한다.
+  // DNS 리바인딩으로 들어온 요청은 공격자 이름을 Host에 달고 온다. 목록은 ALLOWED_HOSTS(쉼표로 구분),
+  // 비어 있으면 이 PC에서 부르는 이름(127.0.0.1·localhost + 포트)만 허용한다(비었다고 모두 열지 않는다)
+  const port = process.env.PORT || '3000';
+  const allowedHosts = (process.env.ALLOWED_HOSTS || `127.0.0.1:${port},localhost:${port}`)
+    .split(',')
+    .map((h) => h.trim().toLowerCase())
+    .filter(Boolean);
+  app.use((request, response, next) => {
+    const host = (request.get('host') || '').toLowerCase();
+    if (allowedHosts.includes(host)) {
+      return next();
+    }
+    // ⑤ 탐지: 낯선 Host. 이름은 64자까지만
+    securityEvent.denied('request.denied.host', '2-6', request, {
+      target: `host:${host.slice(0, 64) || '-'}`,
+      reason: '허용하지 않은 Host'
+    });
+    response.status(403).json({ error: { status: 403, message: 'Forbidden host' } });
+  });
+
