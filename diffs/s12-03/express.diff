+/** 12-3: 파트너 입구가 확인한 클라이언트 인증서의 지문(x5t#S256 = base64url(SHA-256(DER)))과 CN. 없거나 못 읽으면 null */
+export async function clientCert(request: Request): Promise<{ thumbprint: string; cn: string | null } | null> {
+  if (!(await fromPartnerGateway(request))) return null;
+  const header = request.get('x-daon-client-cert');
+  if (!header) return null;
+  try {
+    const cert = new X509Certificate(decodeURIComponent(header));
+    const cn = (cert.subject.split('\n').find((l) => l.startsWith('CN=')) || '').slice(3) || null;
+    return { thumbprint: createHash('sha256').update(cert.raw).digest('base64url'), cn };
+  } catch (e) {
+    return null;
+  }
+}
