diff --git a/packages/evershop/src/modules/customer/api/daonLockCustomer/daonLockCustomer.ts b/packages/evershop/src/modules/customer/api/daonLockCustomer/daonLockCustomer.ts
new file mode 100644
index 0000000..5eea007
--- /dev/null
+++ b/packages/evershop/src/modules/customer/api/daonLockCustomer/daonLockCustomer.ts
@@ -0,0 +1,39 @@
+import { select, update } from '@evershop/postgres-query-builder';
+import { securityEvent } from '../../../../lib/log/securityEvent.js';
+import { pool } from '../../../../lib/postgres/connection.js';
+import { INVALID_PAYLOAD, NOT_FOUND, OK } from '../../../../lib/util/httpStatus.js';
+import { EvershopRequest } from '../../../../types/request.js';
+
+/**
+ * 다온마켓 14-4(Express): 사고 대응 격리. POST /api/customers/:uuid/lock {"incidentId":"INC-14-4","reason":"…"}
+ * ① 고객 상태 0(잠금) → 로그인·현재 고객 읽기(getCurrentCustomer는 status=1만 읽는다)가 막힌다
+ * ② 그 고객의 세션을 모두 지운다(세션 저장소 = PostgreSQL session 표, sess.customerID) → 지금 쓰는 세션도 끊긴다
+ * ③ incident.actor.locked(INFO). 고위험 기능이라 13-6 권한 상승(묶음 incident-response)을 거친다([auth]daonElevation.ts)
+ * 응답에는 고객 uuid와 지운 세션 수만(개인정보 없음).
+ */
+export default async (request: EvershopRequest, response) => {
+  const uuid = String(request.params.id);
+  const incident = String(request.body?.incidentId || '').trim();
+  const reason = String(request.body?.reason || '').trim();
+  if (!/^[A-Za-z0-9-]{3,40}$/.test(incident) || !reason || reason.length > 100) {
+    response.status(INVALID_PAYLOAD);
+    response.json({ error: { status: INVALID_PAYLOAD, message: '사고 번호(영문·숫자·하이픈)와 사유(100자까지)가 필요합니다' } });
+    return;
+  }
+  const customer = await select('customer_id').from('customer').where('uuid', '=', uuid).load(pool);
+  if (!customer) {
+    response.status(NOT_FOUND);
+    response.json({ error: { status: NOT_FOUND, message: '고객을 찾을 수 없습니다' } });
+    return;
+  }
+  await update('customer').given({ status: 0 }).where('customer_id', '=', customer.customer_id).execute(pool);
+  const killed = await pool.query("DELETE FROM session WHERE sess->>'customerID' = $1", [String(customer.customer_id)]);
+  const user = request.getCurrentUser() as any;
+  securityEvent.suspicious('incident.actor.locked', '14-4', request, {
+    actor: `admin:${user?.uuid}`,
+    target: `customer:${uuid}`,
+    reason: `사고 대응 격리(사고 번호 ${incident})`
+  });
+  response.status(OK);
+  response.json({ data: { customer: uuid, status: 'locked', sessionsDestroyed: killed.rowCount } });
+};
