<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.securekit</groupId>
        <artifactId>secure-kit-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>secure-kit-spring-boot-starter</artifactId>
    <name>secure-kit-spring-boot-starter</name>
    <description>의존성 한 줄로 붙이는 자동 설정. secure-kit.* 설정으로 부품을 켠다</description>

    <dependencies>
        <dependency>
            <groupId>io.github.securekit</groupId>
            <artifactId>secure-kit-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.securekit</groupId>
            <artifactId>secure-kit-web</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.securekit</groupId>
            <artifactId>secure-kit-audit</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.securekit</groupId>
            <artifactId>secure-kit-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-redis</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
