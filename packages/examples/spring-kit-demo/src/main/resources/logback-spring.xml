<?xml version="1.0" encoding="UTF-8"?>
<!-- 로그 가리기(log-masking): %kitmsg = 가린 메시지. 콘솔과 랩 전용 최근 로그(/_kit/logs)가 같은 줄을 쓴다 -->
<configuration>
    <conversionRule conversionWord="kitmsg" converterClass="io.github.securekit.audit.MaskingConverter"/>
    <property name="KIT_PATTERN" value="%d{HH:mm:ss.SSS} %level %logger{36} %kitmsg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${KIT_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 랩 전용: 최근 200줄. 회사 서비스에는 붙이지 않는다 -->
    <appender name="KIT_BUFFER" class="io.github.securekit.audit.KitLogBuffer">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${KIT_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="KIT_BUFFER"/>
    </root>
</configuration>
